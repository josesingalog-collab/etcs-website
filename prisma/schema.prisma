generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  PROCESSED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  description       String            @db.Text
  location          String            @db.VarChar(300)
  category          String            @db.VarChar(300)
  status            String            @db.VarChar(300)
  projectDate       DateTime?
  publicationStatus PublicationStatus @default(DRAFT)
  images            ProjectImage[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String  @db.VarChar(1000)
  alt       String? @db.VarChar(500)
  position  Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Service {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  excerpt           String            @db.Text
  description       String            @db.Text
  image             String?           @db.VarChar(1000)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Article {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  excerpt           String            @db.Text
  content           String            @db.Text
  coverImage        String?           @db.VarChar(1000)
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model QuoteRequest {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String
  subject      String        @db.VarChar(500)
  message      String        @db.Text
  localisation String?       @db.VarChar(300)
  planUrl      String?       @db.VarChar(1000)
  status       RequestStatus @default(NEW)
  createdAt    DateTime      @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String        @db.VarChar(500)
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model TeamMember {
  id                String            @id @default(cuid())
  name              String
  role              String            @db.VarChar(300)
  bio               String?           @db.Text
  photo             String?           @db.VarChar(1000)
  position          Int               @default(0)
  publicationStatus PublicationStatus @default(PUBLISHED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model PageContent {
  id        Int      @id @default(autoincrement())
  page      String   @unique @db.VarChar(50)
  data      Json
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id           Int      @id @default(1)
  companyName  String   @default("ETCS SARL")
  phone        String
  phones       Json?
  email        String
  address      String   @db.VarChar(500)
  aboutText    String?  @db.Text
  socialLinks  Json?
  keyStats      Json?
  mapEmbedUrl   String? @db.VarChar(1000)
  logoUrl       String? @db.VarChar(1000)
  heroImageUrl String? @db.VarChar(1000)
  updatedAt    DateTime @updatedAt
}
